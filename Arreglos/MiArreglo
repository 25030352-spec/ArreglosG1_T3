using System;

namespace Arreglos.logica
{
  
        private int[] _arreglo;
        private int _tope;

        // Constructor
        public MiArreglo(int n)
        {
            N = n;
            _arreglo = new int[N];
            _tope = 0;
        }

        // Propiedades
        public int N { get; }
        public bool EstaLleno => _tope == N;
        public bool EstaVacio => _tope == 0;
 // Método llenar
        public void Llenar(int minimo, int maximo)
        {
            Random orandom = new Random();

            for (int i = 0; i < N; i++)
            {
                _arreglo[i] = orandom.Next(minimo, maximo + 1);
            }

            _tope = N;
        }

         // Método ordenar por defecto (ascendente)
        public void ordenar()
        {
            Ordenar(true);
        }

        // Método ordenar (burbuja)
        public void Ordenar(bool ascendente)
        {
            for (int i = 0; i < _tope - 1; i++)
            {
                for (int j = 0; j < _tope - 1 - i; j++)
                {
                    if (ascendente)
                    {
                        if (_arreglo[j] > _arreglo[j + 1])
                        {
                            cambiar(ref _arreglo[j], ref _arreglo[j + 1]);
                        }
                    }
                    else
                    {
                        if (_arreglo[j] < _arreglo[j + 1])
                        {
                            cambiar(ref _arreglo[j], ref _arreglo[j + 1]);
                        }
                    }
                }
            }
        }

}